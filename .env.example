# ============================================================
# Kogan Mobile sign-in settings
# ============================================================
# Copy this file to .env and fill in your own phone numbers and PINs.
# .env is ignored by .gitignore and is never committed.
#
# The phone number may be the mobile, service or account number, written
# exactly as you type it on the website (for example 0400000000).
# The PIN is 6 digits (the website allows at most 6).

# --- Option A: one account per line, in the form phone:PIN ---
KOGAN_ACCOUNTS=0400000000:123456

# Separate multiple accounts with a comma or a newline.
# A third field is an optional owner name: phone:PIN:Owner
# KOGAN_ACCOUNTS=0400000000:123456:Alice,0455555555:654321:Bob

# --- Option B: numbered entries (A and B can be mixed) ---
# KOGAN_MSISDN_1=0400000000
# KOGAN_PIN_1=123456
# KOGAN_NAME_1=Alice
# KOGAN_MSISDN_2=0455555555
# KOGAN_PIN_2=654321
# KOGAN_NAME_2=Bob

# --- Owner names (optional) ---
# Map a phone number to the person using it. Names show up in the report header,
# the overview table and the console output. Use any label you like.
KOGAN_OWNERS=0400000000:Alice,0455555555:Bob

# --- Fetch range ---
# Matches the "Your usage in the last" dropdown on the website.
# The website only offers Month (1), 3 Months (3) and 6 Months (6).
KOGAN_MONTHS=1

# Matches the "Usage type" dropdown on the website: All / Data / SMSMMS / Calls
KOGAN_USAGE_TYPE=Data

# --- Language ---
# Default report language: zh (Chinese) or en (English).
# The report header can switch at any time; this only sets the initial one.
KOGAN_LANG=zh

# --- Redaction ---
# Set to 1 to replace every phone number with "Account 1", "Account 2" and so on.
# Use this whenever the report is committed to a public repository or published
# anywhere else. The owner names from KOGAN_ACCOUNTS are still shown, so give
# each number a nickname rather than a real name if you use this.
KOGAN_REDACT=0

# Set to 1 to hide the owner names as well, leaving only "Account 1" etc.
KOGAN_HIDE_NAMES=0

# Set to 1 to show the phone number as "040****123" instead of "Account 1".
# Easier to tell the accounts apart, but it still reveals the first and last
# three digits, so only use it where that is acceptable.
KOGAN_MASK_NUMBERS=0

# --- Cleanup rules ---
# Records below this many MB are ignored (default 1).
KOGAN_MIN_MB=1

# Records above this many MB are highlighted (default 50).
KOGAN_HIGHLIGHT_MB=50

# Bytes per MB used for rows shown as "B".
# 1048576 = binary (default, matches the Kogan footer total), 1000000 = decimal
KOGAN_MB_BASE=1048576

# --- Output ---
KOGAN_OUT_FILE=out/usage-report.html

# --- Frozen reports (keeping more than the six months Kogan shows) ---
# Every few months a copy of the report is published beside it and never touched
# again, so the days Kogan has dropped stay readable. Off until a directory is
# set: this is where those copies go on the published site.
KOGAN_ARCHIVE_DIR=

# Where the list of frozen reports lives (default: <KOGAN_ARCHIVE_DIR>/archives.json).
KOGAN_ARCHIVE_INDEX=

# The first freeze is counted from this day, then every KOGAN_ARCHIVE_EVERY_MONTHS
# months after the newest data the last frozen report covered.
KOGAN_ARCHIVE_ANCHOR=2026-10-06
KOGAN_ARCHIVE_EVERY_MONTHS=5

# Public address of the report. The links between the current report and the
# frozen copies are absolute, so the same page works from the site root and from
# inside the archive directory.
KOGAN_BASE_URL=
